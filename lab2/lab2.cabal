cabal-version:      2.4
name:               lab2
version:            0.1.0.0
synopsis:           Обмінне сортування зі злиттям Бетчера у k потоків
build-type:         Simple

executable lab2
    main-is:          Main.hs
    hs-source-dirs:   src
    build-depends:    base >=4 && <5
                    , array
    default-language: Haskell2010
    ghc-options:      -Wall -O2 -threaded -rtsopts "-with-rtsopts=-N"
